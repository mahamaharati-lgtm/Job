# Copy to .env and fill in. Never commit .env.

# --- Required in production ---------------------------------------------------
# Dashboard password (or ADMIN_PASSWORD_HASH from: npm run cli -- hash-password '<pw>')
ADMIN_PASSWORD=
# Encrypts resumes, profile, answers and screenshots at rest. Generate: openssl rand -base64 32
# Keep a copy somewhere safe: without it stored data cannot be decrypted.
DATA_ENCRYPTION_KEY=

# --- Recommended --------------------------------------------------------------
NODE_ENV=production
PORT=8080
DATA_DIR=./data
APP_TIMEZONE=Asia/Kolkata
# Public URL of the dashboard (used for links in notifications)
PUBLIC_URL=
# Secret for the optional external scheduler trigger (POST /api/internal/tick)
CRON_SECRET=

# --- Job sources ---------------------------------------------------------------
# Adzuna (free key at https://developer.adzuna.com) — keyword + city search for India and more
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Optional: Claude for better extraction/tailoring/cover letters -------------
# Without a key everything works deterministically. Every AI rewrite is fact-checked.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- Notifications (enable channels in Settings → Notifications) ---------------
# Email via SMTP (e.g. Gmail with an App Password: smtp.gmail.com / 465 / SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Telegram bot token from @BotFather (chat id goes in the dashboard)
TELEGRAM_BOT_TOKEN=

# --- Browser automation --------------------------------------------------------
# Only needed if Chromium is not where Playwright expects it
CHROMIUM_EXECUTABLE_PATH=
BROWSER_HEADLESS=true
LOG_LEVEL=info
