{
  "name": "job-autopilot",
  "version": "1.0.0",
  "private": true,
  "description": "Personal job-search and application autopilot: resume profile extraction, job discovery, fit scoring, fact-checked resume tailoring, rule-based applications and a dashboard.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "start:web": "node --disable-warning=ExperimentalWarning dist/server/index.js --mode=web",
    "start:worker": "node --disable-warning=ExperimentalWarning dist/server/index.js --mode=worker",
    "cli": "node --disable-warning=ExperimentalWarning dist/server/cli.js",
    "cli:dev": "tsx src/server/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.7",
    "@fastify/static": "10.1.10",
    "cheerio": "1.2.0",
    "docx": "9.15.2",
    "fastify": "5.12.8",
    "mammoth": "1.13.0",
    "nodemailer": "10.3.1",
    "pdfkit": "0.20.2",
    "playwright": "1.63.0",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.106.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
